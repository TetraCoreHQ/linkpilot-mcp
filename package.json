{
  "name": "@uselinkpilot/mcp",
  "version": "0.1.0",
  "description": "MCP server for LinkPilot: short links and end-to-end encrypted one-time secret links, for AI assistants",
  "license": "MIT",
  "type": "module",
  "bin": {
    "linkpilot-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@uselinkpilot/sdk": "^0.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TetraCoreHQ/linkpilot-mcp.git"
  },
  "homepage": "https://uselinkpilot.com/developers",
  "bugs": {
    "url": "https://github.com/TetraCoreHQ/linkpilot-mcp/issues"
  },
  "keywords": [
    "linkpilot",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "secret",
    "one-time-secret",
    "burn-after-reading",
    "end-to-end-encryption",
    "e2ee",
    "share-secret",
    "url-shortener",
    "short-links",
    "ai",
    "agent",
    "claude"
  ],
  "author": "TetraCore"
}
